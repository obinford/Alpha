# ===========================================
# RTM Picks Platform — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- The Odds API ---
THE_ODDS_API_KEY=your-odds-api-key

# --- Upstash Redis (optional, for caching) ---
REDIS_URL=redis://default:password@your-redis.upstash.io:6379

# --- Claude API (AI co-pilot features) ---
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Whop (auth/payments) ---
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-webhook-secret

# --- App Config ---
ENV=development
LOG_LEVEL=info
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
